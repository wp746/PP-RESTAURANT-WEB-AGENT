# Never commit real credentials. The Google email address is NOT an API key.
PP_MODEL_BASE_URL=https://your-openai-compatible-text-model/v1
PP_MODEL_NAME=your-text-and-vision-capable-model
PP_MODEL_API_KEY=replace-in-your-own-environment
PP_VISION_MODEL=
# The site below already exists in Cloudflare Pages:
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=cloudflare_pages_write_scoped_token
CLOUDFLARE_PROJECT_NAME=pp-restaurants
PP_SITE_BASE_URL=https://pp-restaurants.pages.dev
# Optional: require --publish even if credentials exist; never default to deployment.
